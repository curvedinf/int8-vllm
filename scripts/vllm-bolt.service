[Unit]
Description=Nemotron Bolt + LiLiCorr packed INT8 GS128 API (TP4 C8)
Wants=network-online.target
After=network-online.target vllm.service
Conflicts=vllm.service vllm-qwen38.service llama-api-4x64k.service vllm-openai-gfx908.service

[Service]
Type=simple
User=curved
Group=curved
SupplementaryGroups=video render
WorkingDirectory=/home/curved/int8-vllm
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/llama/llama-api.env
ExecStartPre=/home/curved/int8-vllm/scripts/serve_recipe_bolt.sh stop
ExecStart=/home/curved/int8-vllm/scripts/serve_recipe_bolt.sh supervise
ExecStop=/home/curved/int8-vllm/scripts/serve_recipe_bolt.sh stop
Restart=always
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=75
LimitNOFILE=1048576
LimitMEMLOCK=infinity
TasksMax=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
