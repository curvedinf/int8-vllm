[Unit]
Description=Recipe Qwen3.8+DFlash2 AITER W8A8 INT8 API (TP4 C8)
Wants=network-online.target
After=network-online.target
Conflicts=llama-api-4x64k.service vllm-openai-gfx908.service

[Service]
Type=simple
User=curved
Group=curved
SupplementaryGroups=video render
WorkingDirectory=/home/curved/vllm-gfx908
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/llama/llama-api.env
ExecStartPre=/home/curved/vllm-gfx908/scripts/serve_recipe_qwen38.sh stop
ExecStart=/home/curved/vllm-gfx908/scripts/serve_recipe_qwen38.sh supervise
ExecStop=/home/curved/vllm-gfx908/scripts/serve_recipe_qwen38.sh stop
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=45
LimitNOFILE=1048576
LimitMEMLOCK=infinity
TasksMax=infinity

[Install]
WantedBy=multi-user.target
