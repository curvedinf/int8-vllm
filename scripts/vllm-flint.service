[Unit]
Description=Flint + Flint-DFlash2 INT8 PTQR API, int8_block_g128 KV (TP4 C12)
Wants=network-online.target
After=network-online.target
# Ports differ (flint 8030, bolt 8020) but all recipes own the same four
# MI100s, so only one may run at a time.
Conflicts=vllm.service vllm-bolt.service vllm-qwen38.service llama-api-4x64k.service vllm-openai-gfx908.service

[Service]
Type=simple
User=curved
Group=curved
SupplementaryGroups=video render
WorkingDirectory=/home/curved/int8-vllm
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/llama/llama-api.env
# Clear a supervisor left by a manual `serve_recipe_flint.sh start`.
ExecStartPre=/home/curved/int8-vllm/scripts/serve_recipe_flint.sh stop
ExecStart=/home/curved/int8-vllm/scripts/serve_recipe_flint.sh supervise
ExecStop=/home/curved/int8-vllm/scripts/serve_recipe_flint.sh stop
Restart=always
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
# The stop path waits up to 180 s for the supervisor, then 30 s after KILL;
# ExecStartPre runs the same stop, so the start timeout must cover it too.
TimeoutStartSec=300
TimeoutStopSec=120
LimitNOFILE=1048576
LimitMEMLOCK=infinity
TasksMax=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
